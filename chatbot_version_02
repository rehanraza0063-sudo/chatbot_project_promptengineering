import tkinter as tk
from tkinter import scrolledtext, messagebox
from openai import OpenAI
import threading


# ============================================================
# REAL AI CHATBOT
# Python + Tkinter + OpenAI API
# ============================================================

try:
    client = OpenAI()
except Exception as e:
    client = None


# Store conversation history
conversation = [
    {
        "role": "system",
        "content": (
            "You are a helpful, friendly and educational AI assistant. "
            "Give clear and easy-to-understand answers. "
            "When explaining technical topics, use examples when useful."
        )
    }
]


# ============================================================
# AI RESPONSE
# ============================================================

def get_ai_response(user_message):

    if client is None:
        return "OpenAI client could not be initialized."

    try:

        # Add user's message to conversation
        conversation.append(
            {
                "role": "user",
                "content": user_message
            }
        )

        # Send conversation to AI
        response = client.responses.create(
            model="gpt-5.6-luna",
            input=conversation
        )

        # Get AI response
        ai_response = response.output_text

        # Store AI response in memory
        conversation.append(
            {
                "role": "assistant",
                "content": ai_response
            }
        )

        return ai_response

    except Exception as e:

        return (
            "Sorry, I couldn't connect to the AI service.\n\n"
            "Error: " + str(e)
        )


# ============================================================
# SEND MESSAGE
# ============================================================

def send_message(event=None):

    user_message = input_box.get().strip()

    if user_message == "":
        return

    # Display user message
    chat_area.config(state=tk.NORMAL)

    chat_area.insert(
        tk.END,
        "You:\n" + user_message + "\n\n",
        "user"
    )

    chat_area.config(state=tk.DISABLED)

    input_box.delete(0, tk.END)

    # Disable send button while AI is responding
    send_button.config(
        state=tk.DISABLED
    )

    status_label.config(
        text="AI is thinking..."
    )

    # Run API request in background
    thread = threading.Thread(
        target=generate_response,
        args=(user_message,)
    )

    thread.daemon = True
    thread.start()


# ============================================================
# GENERATE RESPONSE
# ============================================================

def generate_response(user_message):

    response = get_ai_response(user_message)

    # Update GUI safely
    root.after(
        0,
        display_response,
        response
    )


# ============================================================
# DISPLAY AI RESPONSE
# ============================================================

def display_response(response):

    chat_area.config(state=tk.NORMAL)

    chat_area.insert(
        tk.END,
        "AI:\n" + response + "\n\n",
        "ai"
    )

    chat_area.config(state=tk.DISABLED)

    chat_area.see(tk.END)

    send_button.config(
        state=tk.NORMAL
    )

    status_label.config(
        text="Ready"
    )

    input_box.focus()


# ============================================================
# CLEAR CHAT
# ============================================================

def clear_chat():

    global conversation

    conversation = [
        {
            "role": "system",
            "content": (
                "You are a helpful, friendly and educational AI assistant. "
                "Give clear and easy-to-understand answers. "
                "When explaining technical topics, use examples when useful."
            )
        }
    ]

    chat_area.config(
        state=tk.NORMAL
    )

    chat_area.delete(
        "1.0",
        tk.END
    )

    chat_area.insert(
        tk.END,
        "AI:\nHello! 👋 I'm your AI assistant.\n"
        "How can I help you today?\n\n",
        "ai"
    )

    chat_area.config(
        state=tk.DISABLED
    )

    status_label.config(
        text="Ready"
    )


# ============================================================
# MAIN WINDOW
# ============================================================

root = tk.Tk()

root.title(
    "AI Chatbot - Python"
)

root.geometry(
    "800x700"
)

root.resizable(
    False,
    False
)


# ============================================================
# HEADER
# ============================================================

header_frame = tk.Frame(
    root
)

header_frame.pack(
    pady=15
)

title_label = tk.Label(
    header_frame,
    text="🤖 AI CHATBOT",
    font=("Arial", 25, "bold")
)

title_label.pack()

subtitle_label = tk.Label(
    header_frame,
    text="Python • Tkinter • OpenAI API",
    font=("Arial", 11)
)

subtitle_label.pack(
    pady=5
)


# ============================================================
# CHAT AREA
# ============================================================

chat_area = scrolledtext.ScrolledText(
    root,
    width=85,
    height=28,
    font=("Arial", 11),
    wrap=tk.WORD
)

chat_area.pack(
    padx=20,
    pady=10
)


# Text formatting

chat_area.tag_config(
    "user",
    font=("Arial", 11, "bold")
)

chat_area.tag_config(
    "ai",
    font=("Arial", 11)
)


# Initial message

chat_area.insert(
    tk.END,
    "AI:\nHello! 👋 I'm your AI assistant.\n"
    "How can I help you today?\n\n",
    "ai"
)

chat_area.config(
    state=tk.DISABLED
)


# ============================================================
# INPUT FRAME
# ============================================================

input_frame = tk.Frame(
    root
)

input_frame.pack(
    padx=20,
    pady=10,
    fill=tk.X
)


# Input field

input_box = tk.Entry(
    input_frame,
    font=("Arial", 12)
)

input_box.pack(
    side=tk.LEFT,
    fill=tk.X,
    expand=True,
    ipady=10
)


# Send button

send_button = tk.Button(
    input_frame,
    text="SEND",
    font=("Arial", 11, "bold"),
    command=send_message,
    padx=20,
    pady=8
)

send_button.pack(
    side=tk.LEFT,
    padx=8
)


# Clear button

clear_button = tk.Button(
    input_frame,
    text="CLEAR",
    font=("Arial", 11, "bold"),
    command=clear_chat,
    padx=15,
    pady=8
)

clear_button.pack(
    side=tk.LEFT
)


# Enter key

input_box.bind(
    "<Return>",
    send_message
)


# ============================================================
# STATUS
# ============================================================

status_label = tk.Label(
    root,
    text="Ready",
    font=("Arial", 10)
)

status_label.pack(
    pady=5
)


# ============================================================
# FOOTER
# ============================================================

footer_label = tk.Label(
    root,
    text="AI-assisted conversational application",
    font=("Arial", 9)
)

footer_label.pack(
    pady=5
)


# Focus input

input_box.focus()


# ============================================================
# START APPLICATION
# ============================================================

root.mainloop()
